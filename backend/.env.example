# کپی کنید به .env و مقدارها را عوض کنید (فایل .env هرگز commit نشود)
PORT=4000
NODE_ENV=development
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/freelance_marketplace
# حداقل ۳۲ کاراکتر تصادفی:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# آدرس فرانت‌اند برای ساخت لینک بازیابی
APP_URL=http://localhost:5173
RESET_TOKEN_TTL_MINUTES=30
